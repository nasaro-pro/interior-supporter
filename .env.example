# .env.example — 환경변수 목록의 원본 (docs/00_헌법_공통규칙.md 5.4, docs/03_아키텍처_데이터_보안.md 8.1)
# 로컬: 이 파일을 .env.local 로 복사해 값을 채운다 (npm run env:init). .env.local 은 제출·공유하지 않는다.
# 운영: Render 대시보드(Environment)에 같은 이름으로 넣는다. 값은 문서·코드·로그·AI 대화·제출본에 쓰지 않는다 (00 헌법 2장 P-08).
# 규칙: NEXT_PUBLIC_ 접두어 변수는 브라우저 번들에 그대로 들어간다 → 공개해도 되는 값만. 비밀값에 붙이지 않는다.

# ── Supabase (ADR-002) ───────────────────────────────────────────────
# 프로젝트 URL. 대시보드 Project Settings → API (또는 Data API) → Project URL
# 로컬 Docker(supabase start) 사용 시: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# 공개(anon) 키. 새 형식의 publishable 키(sb_publishable_...)도 사용 가능. RLS 가 보호하므로 공개 가능한 값.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [비밀] service_role 키 (또는 새 형식 secret 키 sb_secret_...). RLS 를 우회한다.
# 서버 전용: src/shared/lib/supabase/admin.ts 한 곳에서만 읽는다. 절대 NEXT_PUBLIC_ 를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 앱 ───────────────────────────────────────────────────────────────
# 서비스의 정식 주소 (끝에 / 없음). 비밀번호 재설정 링크·초대 링크를 만들 때 쓴다 (ADR-004).
# 운영: https://<서비스명>.onrender.com · 로컬: http://localhost:3000 (127.0.0.1 과 섞어 쓰지 않는다)
APP_ORIGIN=http://localhost:3000

# 화면에 보이는 서비스 이름 (PRD 1장)
NEXT_PUBLIC_APP_NAME=인테리어 서포터

# 서버 로그 수준: debug | info | warn | error (운영 기본 info)
LOG_LEVEL=info

# Render 빌드·실행 Node 메이저 버전 (ADR-003). 로컬에서는 쓰이지 않으며 node -v 로 24.x 를 확인한다.
NODE_VERSION=24

# ── Supabase CLI (로컬 개발 도구 전용 — 앱 실행에는 필요 없음) ──────────
# 타입 생성용 프로젝트 ref (비밀 아님). npm run db:types 가 $SUPABASE_PROJECT_REF 로 읽는다.
# npm run db:types 가 이 값을 .env.local 에서 직접 읽는다 (scripts/db-types.mjs).
SUPABASE_PROJECT_REF=

# [비밀] DB 비밀번호. supabase link / db push / db dump 가 환경변수로 읽는다. 제출·공유 금지, Render 에 넣지 않는다.
SUPABASE_DB_PASSWORD=
