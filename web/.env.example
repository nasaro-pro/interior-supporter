# App
NODE_ENV=
NEXT_PUBLIC_APP_URL=
SESSION_COOKIE_NAME=

# Database
DATABASE_URL=
# 비운영 환경이 이 호스트를 가리키면 부팅을 거부한다 (ARCHITECTURE.md 18.1). 선택.
PRODUCTION_DB_HOST=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
